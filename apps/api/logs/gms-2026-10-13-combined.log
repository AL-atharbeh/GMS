{"level":"debug","message":"Query: \n      SELECT\n        wo.\"orderNumber\",\n        wo.\"status\"::text               AS status,\n        wo.\"receivedAt\",\n        wo.\"customerComplaints\",\n        wo.\"customerComplaintsAr\",\n        wo.\"diagnosisNotes\",\n        wo.\"totalAmount\",\n        v.\"make\",\n        v.\"model\",\n        v.\"year\",\n        v.\"plateNumber\",\n        GREATEST(\n          similarity(COALESCE(wo.\"customerComplaints\", ''),   $1),\n          similarity(COALESCE(wo.\"customerComplaintsAr\", ''), $2),\n          similarity(COALESCE(wo.\"diagnosisNotes\", ''),       $3)\n        ) AS similarity\n      FROM \"work_orders\" wo\n      JOIN \"vehicles\" v ON v.\"id\" = wo.\"vehicleId\"\n      WHERE wo.\"tenantId\" = $4\n        AND wo.\"diagnosisNotes\" IS NOT NULL\n        AND ($5::text  IS NULL OR v.\"make\"  ILIKE $6)\n        AND ($7::text IS NULL OR v.\"model\" ILIKE $8)\n        AND GREATEST(\n              similarity(COALESCE(wo.\"customerComplaints\", ''),   $9),\n              similarity(COALESCE(wo.\"customerComplaintsAr\", ''), $10),\n              similarity(COALESCE(wo.\"diagnosisNotes\", ''),       $11)\n            ) > 0.08\n      ORDER BY similarity DESC, wo.\"receivedAt\" DESC\n      LIMIT $12\n     | Params: [\"اهتزاز في المقود على السرعات العالية\",\"اهتزاز في المقود على السرعات العالية\",\"اهتزاز في المقود على السرعات العالية\",\"7cbbbb42-be73-4cdd-b7c5-ffd549ff73b7\",null,null,null,null,\"اهتزاز في المقود على السرعات العالية\",\"اهتزاز في المقود على السرعات العالية\",\"اهتزاز في المقود على السرعات العالية\",10] | Duration: 135ms","timestamp":"2026-10-13 12:34:40"}
